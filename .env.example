# Postgres connection string used by both the API and db/migrate.ts
DATABASE_URL=postgresql://school:school@localhost:5432/school_portal

# Redis connection string, used for stats caching
REDIS_URL=redis://localhost:6379

# Secret used to sign session JWTs — 32+ chars
JWT_SECRET=change-me-to-a-random-32-char-secret

# Google OAuth app credentials (console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/oauth/google/callback

# Groq API key, used by the chatbot extra credit
GROQ_API_KEY=

API_PORT=4000
NODE_ENV=development

# Origin allowed to make credentialed requests to the API (CORS)
WEB_ORIGIN=http://localhost:3000

# Frontend-facing API base URL
NEXT_PUBLIC_API_URL=http://localhost:4000
